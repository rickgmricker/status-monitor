<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI>
      <ComboBox Property="MONITOR_LANGUAGE">
        <ListItem Value="pt-BR" Text="Português"/>
        <ListItem Value="en" Text="English"/>
      </ComboBox>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="Status Monitor" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Text="Installation options"/>
        <Control Id="ServiceInfo" Type="Text" X="20" Y="43" Width="330" Height="32"
                 Text="The on-demand collector is installed and managed automatically."/>
        <Control Id="LanguageLabel" Type="Text" X="20" Y="86" Width="145" Height="15" Text="Initial app language:"/>
        <Control Id="Language" Type="ComboBox" Property="MONITOR_LANGUAGE" X="175" Y="82" Width="175" Height="60"
                 ComboList="yes" Sorted="no"/>
        <Control Id="Startup" Type="CheckBox" Property="MONITOR_STARTUP" CheckBoxValue="1" X="20" Y="118" Width="330" Height="32"
                 Text="Start with Windows"/>
        <?ifdef JpDesktopShortcutPrompt ?>
        <Control Id="InstallDesktopShortcut" Type="CheckBox" Property="JP_INSTALL_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 X="20" Y="160" Width="330" Height="17" Text="Desktop shortcut"/>
        <?endif?>
        <?ifdef JpStartMenuShortcutPrompt ?>
        <Control Id="InstallStartMenuShortcut" Type="CheckBox" Property="JP_INSTALL_STARTMENU_SHORTCUT" CheckBoxValue="1"
                 X="20" Y="185" Width="330" Height="17" Text="Start menu shortcut"/>
        <?endif?>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Back" Type="PushButton" X="158" Y="243" Width="65" Height="17" Text="Back"/>
        <Control Id="Next" Type="PushButton" X="225" Y="243" Width="65" Height="17" Default="yes" Text="Next">
          <Publish Property="MONITOR_OPTIONS_SET" Value="1" Order="0">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="294" Y="243" Width="66" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
